{
  "name": "reviewsphere",
  "version": "1.0.0",
  "private": true,
  "description": "ReviewSphere - Full-Stack Customer Review, Reputation & Feedback Intelligence Platform",
  "scripts": {
    "start": "node server/src/index.js",
    "server": "node server/src/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npm run build",
    "seed": "node server/src/seed/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
